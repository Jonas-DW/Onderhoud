BEGIN:VEVENT
UID:buiten-weekend-1@jonas-dw-onderhoud
DTSTAMP:20261125T130000Z
DTSTART;VALUE=DATE:20270102
SUMMARY:🌿 Tuin\, terras en Gardena - maandonderhoud
DESCRIPTION:Tuin\, terras en Gardena. Pas aan het weer en groeistadium aan.
 \n\nControleer stormschade. Laat prairieplanten en siergrassen staan als w
 interbeschutting. Controleer klimplanten en de winterstalling van de Garde
 na.
RRULE:FREQ=YEARLY;BYMONTH=1;BYDAY=1SA
TRANSP:TRANSPARENT
CATEGORIES:Vast onderhoud
X-ONDERHOUD-TYPE:VASTE-DATUM
END:VEVENT
